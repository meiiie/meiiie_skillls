   "dist": 4,
   "dir": 90,
   "color": "#3A2E20",
   "alpha": 0.14
  }
 },
 "screen": {
  "bezel": "#FBF8F2",
  "line": "#D3C9B8",
  "line_width": 0.75,
  "radius": 0.02,
  "bar": "#EFE8DC"
 },
 "shadow": {
  "blur": 22,
  "dist": 6,
  "dir": 90,
  "color": "#3A2E20",
  "alpha": 0.18
 },
 "photo": {
  "duotone": [
   "#1B1815",
   "#F3EEE4"
  ],
  "veil": 0.55
 },
 "motion": {
  "default_ms": 1300,
  "bloom_ms": 2000,
  "stagger_ms": 220
 },
 "signature_ideas": [
  "a vermilion margin mark that walks down the page with the argument",
  "one hairline that becomes the axis of every chart in the deck",
  "the essay's key number set huge in the serif, parked in the margin between chapters"
 ],
