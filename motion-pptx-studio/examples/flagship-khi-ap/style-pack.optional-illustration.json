{
 "_note": "OPTIONAL ILLUSTRATION ONLY: the style pack of an earlier editorial deck, kept to show the JSON shape. Do not reuse its palette or fonts; build your own per topic (principles/art-direction.md).",
 "name": "paper-editorial",
 "label": "Paper editorial: warm paper, ink serif, one vermilion mark, magazine rhythm",
 "genres": [
  "report",
  "essay",
  "keynote",
  "research",
  "policy",
  "journalism",
  "data story",
  "book"
 ],
 "palette": {
  "ground": "#F3EEE4",
  "ground2": "#1B1815",
  "surface": "#FBF8F2",
  "ink": "#1B1815",
  "head": "#14110E",
  "muted": "#5C544B",
  "faint": "#D3C9B8",
  "accent": "#B0321E",
  "accent2": "#21505F",
  "lit": "#14110E",
  "veil": "#F3EEE4"
 },
 "fonts": {
  "display": "Fraunces",
  "text": "Inter",
  "label": "Inter"
 },
 "font_files": [
  {
   "family": "Fraunces",
   "weights": "400,700,400i"
  },
  {
   "family": "Inter",
   "weights": "400,700"
  }
 ],
 "type": {
  "kicker": {
   "font": "label",
   "size": 11,
   "bold": true,
   "spacing": 3,
   "caps": true,
   "color": "accent"
  },
  "display": {
   "font": "display",
   "size": 92,
   "line": 0.9,
   "spacing": -1.5,
   "color": "head"
  },
  "title": {
   "font": "display",
   "size": 46,
   "line": 0.98,
   "spacing": -0.5,
   "color": "head"
  },
  "subtitle": {
   "font": "display",
   "size": 26,
   "italic": true,
   "line": 1.15,
   "color": "muted"
  },
  "body": {
   "font": "text",
   "size": 15,
   "line": 1.42,
   "color": "ink"
  },
  "caption": {
   "font": "text",
   "size": 10,
   "color": "muted"
  },
  "label": {
   "font": "label",
   "size": 10,
   "bold": true,
   "spacing": 2,
   "caps": true,
   "color": "muted"
  },
  "numeral": {
   "font": "display",
   "size": 170,
   "line": 0.85,
   "spacing": -4,
   "color": "accent"
  },
  "quote": {
   "font": "display",
   "size": 36,
   "italic": true,
   "line": 1.1,
   "color": "head"
  },
  "cardtitle": {
   "font": "display",
   "size": 26,
   "line": 1.0,
   "color": "head"
  },
  "pageno": {
   "font": "text",
   "size": 10,
   "spacing": 1,
   "color": "muted"
  }
 },
 "grid": {
  "cols": 12,
  "left": 1.0,
  "right": 1.0,
  "top": 0.9,
  "bottom": 0.75,
  "gutter": 0.25,
  "safe": 0.45
 },
 "default_bg": "main",
 "grounds": {
  "main": {
   "kind": "paper",
   "base": "#F3EEE4",
   "tone": "#E4DACA",
   "grain": 0.03,
   "seed": 21
  },
  "alt": {
   "kind": "paper",
   "base": "#1B1815",
   "tone": "#2A2520",
   "grain": 0.04,
   "seed": 22
  }
 },
 "chrome": {
  "over": [
   {
    "type": "rect",
    "name": "!!topbar",
    "x": 1.0,
    "y": 0.5,
    "w": 0.6,
    "h": 0.06,
    "fill": "accent"
   },
   {
    "type": "text",
    "name": "!!running",
    "text": "{title}",
    "x": 1.8,
    "y": 0.42,
    "w": 7.0,
    "h": 0.22,
    "role": "label"
   },
   {
    "type": "text",
    "name": "!!pageno",
    "text": "{n}",
    "x": 11.633,
    "y": 6.95,
    "w": 0.7,
    "h": 0.25,
    "role": "pageno",
    "align": "r"
   }
  ]
 },
 "card": {
  "fill": "surface",
  "fill_alpha": 1.0,
  "line": "faint",
  "line_width": 0.75,
  "radius": 0.0,
  "lit_fill": "#FFFFFF",
  "lit_line": "accent",
  "rule": "accent",
  "dim_alpha": 0.66,
  "shadow": {
