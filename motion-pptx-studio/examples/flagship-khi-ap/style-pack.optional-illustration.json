   "health": 0.5,
   "climate": 0.5
  },
  "tones": [
   "calm",
   "warm",
   "precise",
   "editorial",
   "serious"
  ],
  "material": {
   "bright": 0.6,
   "muted": 0.5,
   "archival": 0.4
  },
  "avoid": []
 }
}