   "accent": "teal for the measured throughput",
   "accent2": "navy for capacity, the lit bar on the capacity slide",
   "motion": "bars grow from the baseline (how a quantity is made), the line is drawn along its stroke",
   "type": "one sans family pair, numbers at display size",
   "grid": "12 columns, figure left, chart right",
   "composition": "one figure + one drawn chart per slide"
  },
  "signature": "the berth bar that splits into the new berth",
