{
  "name": "neo-brutal",
  "label": "Neo-brutalist: bone paper, thick black outlines, flat lime/orange/blue blocks, hard offset shadows",
  "genres": [
    "startup",
    "recipe",
    "how-to",
    "youth",
    "workshop",
    "product",
    "internal culture"
  ],
  "palette": {
    "ground": "#F3EEE3",
    "ground2": "#C5F25A",
    "surface": "#FFFFFF",
    "ink": "#111111",
    "head": "#111111",
    "muted": "#4A463F",
    "faint": "#D9D1C0",
    "accent": "#FF5A36",
    "accent2": "#3D5AFE",
    "lit": "#C5F25A",
    "veil": "#111111"
  },
  "fonts": {
    "display": "Dela Gothic One",
    "text": "Space Grotesk",
    "label": "Space Mono"
  },
  "font_files": [
    {
      "family": "Dela Gothic One",
      "weights": "400"
    },
    {
      "family": "Space Grotesk",
      "weights": "400,700"
    },
    {
      "family": "Space Mono",
      "weights": "400,700"
    }
  ],
  "type": {
    "kicker": {
      "font": "label",
      "size": 12,
      "bold": true,
      "spacing": 1,
      "caps": true,
      "color": "ink"
    },
    "display": {
      "font": "display",
      "size": 84,
      "line": 1.0,
      "spacing": -1,
      "color": "head"
    },
    "title": {
      "font": "display",
      "size": 42,
      "line": 1.05,
      "color": "head"
    },
    "subtitle": {
      "font": "text",
      "size": 22,
      "line": 1.25,
      "color": "muted"
    },
    "body": {
      "font": "text",
      "size": 17,
      "line": 1.35,
      "color": "ink"
    },
    "caption": {
      "font": "text",
      "size": 10,
      "color": "muted"
    },
    "label": {
      "font": "label",
      "size": 11,
      "bold": true,
      "spacing": 1,
      "caps": true,
      "color": "muted"
    },
    "numeral": {
      "font": "display",
      "size": 170,
      "bold": true,
      "line": 0.82,
      "spacing": -4,
      "color": "accent"
    },
    "quote": {
      "font": "display",
      "size": 36,
      "bold": true,
      "line": 1.08,
      "color": "head"
    },
    "cardtitle": {
      "font": "display",
      "size": 22,
      "line": 1.05,
      "color": "head"
    },
    "pageno": {
      "font": "label",
      "size": 10,
      "bold": true,
      "color": "muted"
    }
  },
  "grid": {
    "cols": 12,
    "left": 0.9,
    "right": 0.9,
    "top": 0.8,
    "bottom": 0.8,
    "gutter": 0.25,
    "safe": 0.45
  },
  "default_bg": "main",
  "grounds": {
    "main": {
      "kind": "flat",
      "base": "#F3EEE3",
      "tone": "#EDE6D7",
      "grain": 0.015,
      "seed": 91
    },
    "alt": {
      "kind": "flat",
      "base": "#C5F25A",
      "tone": "#BBEA4D",
      "grain": 0.015,
      "seed": 92
    }
  },
  "chrome": {
    "over": [
      {
        "type": "rect",
        "name": "!!badge",
        "x": 11.433,
        "y": 6.75,
        "w": 1.0,
        "h": 0.4,
        "fill": "ink"
      },
      {
        "type": "text",
        "name": "!!pageno",
        "text": "#{n}",
        "x": 11.433,
        "y": 6.75,
        "w": 1.0,
        "h": 0.4,
        "role": "pageno",
        "align": "c",
        "anchor": "m",
        "color": "ground"
      }
    ]
  },
  "card": {
    "fill": "surface",
    "fill_alpha": 1.0,
    "line": "ink",
    "line_width": 2.5,
    "radius": 0.0,
    "lit_fill": "ground2",
    "lit_line": "ink",
    "rule": "accent",
    "dim_alpha": 0.6,
    "shadow": {
      "blur": 0,
      "dist": 8,
      "dir": 45,
      "color": "#111111",
      "alpha": 1.0
    }
  },
  "screen": {
    "bezel": "#FFFFFF",
    "line": "#111111",
    "line_width": 2.5,
    "radius": 0.0,
    "bar": "#FF5A36"
  },
  "shadow": {
    "blur": 0,
    "dist": 8,
    "dir": 45,
    "color": "#111111",
    "alpha": 1.0
  },
  "photo": {
    "duotone": null,
    "veil": 0.5
  },
  "motion": {
    "default_ms": 800,
    "bloom_ms": 1200,
    "stagger_ms": 120,
    "transitions": [
      "push",
      "cover",
      "split",
      "morph"
    ],
    "effects": [
      "drop",
      "teeter",
      "pulse",
      "fly"
    ]
  },
  "signature_ideas": [
    "step cards slammed down one by one (fx drop) with their hard shadows",
    "a sticker that teeters (emphasis) when the presenter clicks it (trigger)",
    "a slide that Pushes like a sheet of paper on a desk"
  ]
}