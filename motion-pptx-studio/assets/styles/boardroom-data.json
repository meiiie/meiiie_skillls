{
  "name": "boardroom-data",
  "label": "Boardroom data: cool light ground, deep teal signal, numbers as heroes",
  "genres": ["business review", "quarterly report", "investor pitch", "consulting", "finance", "operations", "kpi"],
  "palette": {
    "ground": "#F5F7FA",
    "ground2": "#0B1220",
    "surface": "#FFFFFF",
    "ink": "#0F1722",
    "head": "#0B1220",
    "muted": "#4E5A6A",
    "faint": "#D5DCE4",
    "accent": "#0E7C6B",
    "accent2": "#F2542D",
    "lit": "#0B1220",
    "veil": "#0B1220"
  },
  "fonts": {"display": "Plus Jakarta Sans", "text": "Inter", "label": "Inter"},
  "font_files": [
    {"family": "Plus Jakarta Sans", "weights": "400,700"},
    {"family": "Inter", "weights": "400,700"}
  ],
  "type": {
    "kicker":   {"font": "label", "size": 11, "bold": true, "spacing": 2, "caps": true, "color": "accent"},
    "display":  {"font": "display", "size": 80, "bold": true, "line": 0.95, "spacing": -2, "color": "head"},
    "title":    {"font": "display", "size": 40, "bold": true, "line": 1.0, "spacing": -0.8, "color": "head"},
    "subtitle": {"font": "text", "size": 20, "line": 1.25, "color": "muted"},
    "body":     {"font": "text", "size": 15, "line": 1.4, "color": "ink"},
    "caption":  {"font": "text", "size": 9, "color": "muted"},
    "label":    {"font": "label", "size": 10, "bold": true, "spacing": 1, "caps": true, "color": "muted"},
    "numeral":  {"font": "display", "size": 140, "bold": true, "line": 0.85, "spacing": -4, "color": "accent"},
    "quote":    {"font": "display", "size": 30, "line": 1.15, "color": "head"},
    "cardtitle":{"font": "display", "size": 22, "bold": true, "line": 1.05, "color": "head"},
    "pageno":   {"font": "text", "size": 9, "color": "muted"}
  },
  "grid": {"cols": 12, "left": 0.9, "right": 0.9, "top": 0.8, "bottom": 0.8, "gutter": 0.25, "safe": 0.45},
  "default_bg": "main",
  "grounds": {
    "main": {"kind": "clean", "base": "#F5F7FA", "tone": "#E7ECF2", "grid": 0.5, "grid_alpha": 0.05, "grain": 0.012, "seed": 31},
    "alt":  {"kind": "clean", "base": "#0B1220", "tone": "#13203A", "grid": 0.5, "grid_alpha": 0.05, "grain": 0.02, "seed": 32}
  },
  "chrome": {
    "over": [
      {"type": "rect", "name": "!!accentbar", "x": 0.9, "y": 0.6, "w": 0.42, "h": 0.07, "fill": "accent"},
      {"type": "line", "name": "!!foot", "x1": 0.9, "y1": 6.9, "x2": 12.433, "y2": 6.9, "color": "faint", "width": 0.5},
      {"type": "text", "name": "!!source", "text": "{source}", "x": 0.9, "y": 6.98, "w": 9.0, "h": 0.22, "role": "caption"},
      {"type": "text", "name": "!!pageno", "text": "{n}", "x": 11.933, "y": 6.98, "w": 0.5, "h": 0.22, "role": "pageno", "align": "r"}
    ]
  },
  "card": {"fill": "surface", "fill_alpha": 1.0, "line": "faint", "line_width": 0.75, "radius": 0.05,
           "lit_fill": "#FFFFFF", "lit_line": "accent", "rule": "accent", "dim_alpha": 0.66,
           "shadow": {"blur": 20, "dist": 4, "dir": 90, "color": "#0B1220", "alpha": 0.10}},
  "screen": {"bezel": "#FFFFFF", "line": "#D5DCE4", "line_width": 0.75, "radius": 0.05, "bar": "#EEF2F6"},
  "shadow": {"blur": 24, "dist": 6, "dir": 90, "color": "#0B1220", "alpha": 0.14},
  "photo": {"duotone": ["#0B1220", "#E9EDF2"], "veil": 0.6},
  "motion": {"default_ms": 1200, "bloom_ms": 1800, "stagger_ms": 200},
  "signature_ideas": [
    "the one line that matters (the growth curve) drawn once and carried through every slide as the horizon",
    "a teal bar that is the company: it grows, splits into segments, and becomes the plan",
    "the headline number set huge, then shrinking into the corner as the deck explains it"
  ]
}
