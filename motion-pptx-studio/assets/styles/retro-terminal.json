{
  "name": "retro-terminal",
  "label": "Retro terminal: phosphor green on CRT black, pixel display type, amber cursor; for dev stories and hacks",
  "genres": [
    "developer",
    "security",
    "hackathon",
    "history of computing",
    "game",
    "nostalgia"
  ],
  "palette": {
    "ground": "#061209",
    "ground2": "#0B1F10",
    "surface": "#0A1A0E",
    "ink": "#A6FFA6",
    "head": "#D4FFD4",
    "muted": "#5FAE6A",
    "faint": "#1E4A28",
    "accent": "#FFB000",
    "accent2": "#5FD7FF",
    "lit": "#FFB000",
    "veil": "#000000"
  },
  "fonts": {
    "display": "VT323",
    "text": "IBM Plex Mono",
    "label": "VT323"
  },
  "font_files": [
    {
      "family": "VT323",
      "weights": "400"
    },
    {
      "family": "IBM Plex Mono",
      "weights": "400,700"
    }
  ],
  "type": {
    "kicker": {
      "font": "label",
      "size": 12,
      "bold": true,
      "spacing": 1.5,
      "caps": true,
      "color": "accent"
    },
    "display": {
      "font": "display",
      "size": 112,
      "line": 1.0,
      "color": "head"
    },
    "title": {
      "font": "display",
      "size": 54,
      "line": 0.95,
      "color": "head"
    },
    "subtitle": {
      "font": "text",
      "size": 30,
      "line": 1.25,
      "color": "muted"
    },
    "body": {
      "font": "text",
      "size": 16,
      "line": 1.35,
      "color": "ink"
    },
    "caption": {
      "font": "text",
      "size": 10,
      "color": "muted"
    },
    "label": {
      "font": "label",
      "size": 10,
      "spacing": 1,
      "caps": true,
      "color": "muted"
    },
    "numeral": {
      "font": "display",
      "size": 220,
      "line": 0.8,
      "color": "accent"
    },
    "quote": {
      "font": "display",
      "size": 36,
      "bold": true,
      "line": 1.08,
      "color": "head"
    },
    "cardtitle": {
      "font": "display",
      "size": 30,
      "line": 1.0,
      "color": "head"
    },
    "pageno": {
      "font": "label",
      "size": 10,
      "color": "muted"
    }
  },
  "grid": {
    "cols": 12,
    "left": 0.9,
    "right": 0.9,
    "top": 0.8,
    "bottom": 0.8,
    "gutter": 0.25,
    "safe": 0.45
  },
  "default_bg": "main",
  "grounds": {
    "main": {
      "kind": "scanline",
      "base": "#040B06",
      "tone": "#0C2412",
      "grain": 0.02,
      "vignette": 0.7,
      "seed": 111
    },
    "alt": {
      "kind": "scanline",
      "base": "#0A0700",
      "tone": "#2A1C00",
      "grain": 0.02,
      "vignette": 0.7,
      "seed": 112
    }
  },
  "chrome": {
    "over": [
      {
        "type": "text",
        "name": "!!prompt",
        "text": "~/{scene} $",
        "x": 0.9,
        "y": 0.42,
        "w": 7,
        "h": 0.34,
        "role": "label"
      },
      {
        "type": "text",
        "name": "!!pageno",
        "text": "[{n}/{total}]",
        "x": 10.933,
        "y": 6.82,
        "w": 1.5,
        "h": 0.32,
        "role": "pageno",
        "align": "r"
      }
    ]
  },
  "card": {
    "fill": "surface",
    "fill_alpha": 1.0,
    "line": "muted",
    "line_width": 1.0,
    "radius": 0.0,
    "lit_fill": "#13301A",
    "lit_line": "accent",
    "rule": "accent",
    "dim_alpha": 0.5,
    "shadow": null
  },
  "screen": {
    "bezel": "#0A1A0E",
    "line": "#5FAE6A",
    "line_width": 1.0,
    "radius": 0.0,
    "bar": "#13301A"
  },
  "shadow": null,
  "photo": {
    "duotone": [
      "#020603",
      "#A6FFA6"
    ],
    "veil": 0.6
  },
  "motion": {
    "default_ms": 600,
    "bloom_ms": 900,
    "stagger_ms": 90,
    "transitions": [
      "cut",
      "wipe",
      "dissolve",
      "randombars"
    ],
    "effects": [
      "type",
      "appear",
      "blink"
    ]
  },
  "signature_ideas": [
    "output typed letter by letter, the amber cursor block blinking (blink loop)",
    "a Dissolve/Random Bars transition as the 'screen glitch' between scenes",
    "lines Appear one per click like a log scrolling"
  ],
  "fit": {
    "domains": {
      "software": 1,
      "technology": 0.6
    },
    "tones": [
      "nostalgic",
      "playful",
      "technical"
    ],
    "material": {
      "dark": 0.8
    },
    "avoid": [
      {
        "domain": "heritage",
        "reason": "phosphor-green CRT pastiche has no relation to a cultural tradition"
      },
      {
        "domain": "aerospace",
        "reason": "a hacker-terminal pastiche turns real launch hardware into a joke"
      }
    ]
  }
}
