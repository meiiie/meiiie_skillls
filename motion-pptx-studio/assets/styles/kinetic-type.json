{
  "name": "kinetic-type",
  "label": "Kinetic type: black stage, condensed poster type that IS the image, one signal red; for hooks and manifestos",
  "genres": [
    "keynote opener",
    "manifesto",
    "campaign",
    "hook",
    "event",
    "music",
    "film"
  ],
  "palette": {
    "ground": "#0B0B0C",
    "ground2": "#FF3B21",
    "surface": "#18181B",
    "ink": "#F4F1EA",
    "head": "#FFFFFF",
    "muted": "#8B8A90",
    "faint": "#2C2C31",
    "accent": "#FF4D33",
    "accent2": "#FFD400",
    "lit": "#FF3B21",
    "veil": "#000000"
  },
  "fonts": {
    "display": "Anton",
    "text": "Inter",
    "label": "Space Mono"
  },
  "font_files": [
    {
      "family": "Anton",
      "weights": "400"
    },
    {
      "family": "Inter",
      "weights": "400,700"
    },
    {
      "family": "Space Mono",
      "weights": "400,700"
    }
  ],
  "type": {
    "kicker": {
      "font": "label",
      "size": 12,
      "bold": true,
      "spacing": 1.5,
      "caps": true,
      "color": "accent"
    },
    "display": {
      "font": "display",
      "size": 112,
      "line": 0.86,
      "spacing": 0,
      "caps": true,
      "color": "head"
    },
    "title": {
      "font": "display",
      "size": 64,
      "line": 0.92,
      "spacing": 0,
      "caps": true,
      "color": "head"
    },
    "subtitle": {
      "font": "text",
      "size": 24,
      "line": 1.25,
      "color": "muted"
    },
    "body": {
      "font": "text",
      "size": 17,
      "line": 1.35,
      "color": "ink"
    },
    "caption": {
      "font": "text",
      "size": 11,
      "color": "muted"
    },
    "label": {
      "font": "label",
      "size": 11,
      "bold": true,
      "spacing": 1,
      "caps": true,
      "color": "muted"
    },
    "numeral": {
      "font": "display",
      "size": 260,
      "line": 0.8,
      "color": "accent"
    },
    "quote": {
      "font": "display",
      "size": 36,
      "bold": true,
      "line": 1.08,
      "color": "head"
    },
    "cardtitle": {
      "font": "display",
      "size": 24,
      "bold": true,
      "line": 1.0,
      "color": "head"
    },
    "pageno": {
      "font": "label",
      "size": 11,
      "bold": true,
      "color": "muted"
    }
  },
  "grid": {
    "cols": 12,
    "left": 0.9,
    "right": 0.9,
    "top": 0.8,
    "bottom": 0.8,
    "gutter": 0.25,
    "safe": 0.45
  },
  "default_bg": "main",
  "grounds": {
    "main": {
      "kind": "flat",
      "base": "#0B0B0C",
      "tone": "#151517",
      "grain": 0.03,
      "seed": 81
    },
    "alt": {
      "kind": "flat",
      "base": "#FF3B21",
      "tone": "#EE3018",
      "grain": 0.03,
      "seed": 82
    }
  },
  "chrome": {
    "over": [
      {
        "type": "text",
        "name": "!!pageno",
        "text": "{n}",
        "x": 10.933,
        "y": 6.88,
        "w": 1.5,
        "h": 0.25,
        "role": "pageno",
        "align": "r"
      }
    ]
  },
  "card": {
    "fill": "surface",
    "fill_alpha": 1.0,
    "line": "faint",
    "line_width": 0.75,
    "radius": 0.0,
    "lit_fill": "#26262B",
    "lit_line": "accent",
    "rule": "accent",
    "dim_alpha": 0.6,
    "shadow": null
  },
  "screen": {
    "bezel": "#18181B",
    "line": "#2C2C31",
    "line_width": 0.75,
    "radius": 0.02,
    "bar": "#222226"
  },
  "shadow": null,
  "photo": {
    "duotone": [
      "#0B0B0C",
      "#FF3B21"
    ],
    "veil": 0.6
  },
  "motion": {
    "default_ms": 700,
    "bloom_ms": 1100,
    "stagger_ms": 80,
    "transitions": [
      "cut",
      "push",
      "fallover",
      "morph"
    ],
    "effects": [
      "type",
      "zoom",
      "drop",
      "blink"
    ]
  },
  "signature_ideas": [
    "a line typed letter by letter (fx type, 0.1 s per letter), then one word turns red",
    "a hard Cut between full-bleed words on the beat; one word per slide",
    "a word bigger than the slide that Morphs to a readable size"
  ],
  "fit": {
    "domains": {
      "event": 1,
      "business": 0.3,
      "technology": 0.4,
      "aerospace": 0.3
    },
    "tones": [
      "bold",
      "energetic",
      "cinematic"
    ],
    "material": {
      "dark": 0.6
    },
    "avoid": [
      {
        "domain": "heritage",
        "because": "poster type that IS the image hides the objects and places"
      },
      {
        "domain": "economy",
        "because": "a type-only show of one huge word per slide cannot carry many sourced figures"
      }
    ]
  }
}