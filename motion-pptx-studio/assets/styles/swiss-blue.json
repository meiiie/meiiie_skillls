{
  "name": "swiss-blue",
  "label": "Swiss white-blue: white paper, one cobalt, strict 12-column grid, flush-left grotesk, numbers as heroes",
  "genres": [
    "technology",
    "research",
    "engineering",
    "architecture",
    "public sector",
    "university",
    "report"
  ],
  "palette": {
    "ground": "#FFFFFF",
    "ground2": "#EEF3FF",
    "surface": "#F5F8FF",
    "ink": "#0B1B3F",
    "head": "#0B1B3F",
    "muted": "#3F4B72",
    "faint": "#D5DEF2",
    "accent": "#1F4BFF",
    "accent2": "#00A3E0",
    "lit": "#1F4BFF",
    "veil": "#0B1B3F"
  },
  "fonts": {
    "display": "Archivo",
    "text": "Inter",
    "label": "IBM Plex Mono"
  },
  "font_files": [
    {
      "family": "Archivo",
      "weights": "400,700"
    },
    {
      "family": "Inter",
      "weights": "400,700"
    },
    {
      "family": "IBM Plex Mono",
      "weights": "400,700"
    }
  ],
  "type": {
    "kicker": {
      "font": "label",
      "size": 12,
      "bold": true,
      "spacing": 1.5,
      "caps": true,
      "color": "accent"
    },
    "display": {
      "font": "display",
      "size": 110,
      "bold": true,
      "line": 0.9,
      "spacing": -3,
      "color": "head"
    },
    "title": {
      "font": "display",
      "size": 48,
      "bold": true,
      "line": 0.95,
      "spacing": -1,
      "color": "head"
    },
    "subtitle": {
      "font": "text",
      "size": 24,
      "line": 1.25,
      "color": "muted"
    },
    "body": {
      "font": "text",
      "size": 17,
      "line": 1.35,
      "color": "ink"
    },
    "caption": {
      "font": "text",
      "size": 11,
      "color": "muted"
    },
    "label": {
      "font": "label",
      "size": 11,
      "bold": true,
      "spacing": 1,
      "caps": true,
      "color": "muted"
    },
    "numeral": {
      "font": "display",
      "size": 170,
      "bold": true,
      "line": 0.82,
      "spacing": -4,
      "color": "accent"
    },
    "quote": {
      "font": "display",
      "size": 36,
      "bold": true,
      "line": 1.08,
      "color": "head"
    },
    "cardtitle": {
      "font": "display",
      "size": 24,
      "bold": true,
      "line": 1.0,
      "color": "head"
    },
    "pageno": {
      "font": "label",
      "size": 11,
      "bold": true,
      "color": "muted"
    }
  },
  "grid": {
    "cols": 12,
    "left": 0.9,
    "right": 0.9,
    "top": 0.8,
    "bottom": 0.8,
    "gutter": 0.25,
    "safe": 0.45
  },
  "default_bg": "main",
  "grounds": {
    "main": {
      "kind": "clean",
      "base": "#FFFFFF",
      "tone": "#F3F6FD",
      "grid": 0.5555,
      "grid_alpha": 0.035,
      "grain": 0.0,
      "seed": 61
    },
    "alt": {
      "kind": "flat",
      "base": "#1F4BFF",
      "tone": "#1A3FE0",
      "grain": 0.0,
      "seed": 62
    }
  },
  "chrome": {
    "over": [
      {
        "type": "rect",
        "name": "!!mark",
        "x": 0.9,
        "y": 0.5,
        "w": 0.22,
        "h": 0.22,
        "fill": "accent"
      },
      {
        "type": "text",
        "name": "!!running",
        "text": "{scene}",
        "x": 1.3,
        "y": 0.47,
        "w": 6,
        "h": 0.28,
        "role": "label"
      },
      {
        "type": "line",
        "name": "!!rule",
        "x1": 0.9,
        "y1": 6.78,
        "x2": 12.433,
        "y2": 6.78,
        "color": "faint",
        "width": 0.75
      },
      {
        "type": "text",
        "name": "!!pageno",
        "text": "{n}",
        "x": 10.933,
        "y": 6.88,
        "w": 1.5,
        "h": 0.25,
        "role": "pageno",
        "align": "r"
      }
    ]
  },
  "card": {
    "fill": "surface",
    "fill_alpha": 1.0,
    "line": "faint",
    "line_width": 0.75,
    "radius": 0.0,
    "lit_fill": "#E6EDFF",
    "lit_line": "accent",
    "rule": "accent",
    "dim_alpha": 0.7,
    "shadow": null
  },
  "screen": {
    "bezel": "#FFFFFF",
    "line": "#D5DEF2",
    "line_width": 0.75,
    "radius": 0.02,
    "bar": "#EEF3FF"
  },
  "shadow": null,
  "photo": {
    "duotone": [
      "#0B1B3F",
      "#E6EDFF"
    ],
    "veil": 0.45
  },
  "motion": {
    "default_ms": 900,
    "bloom_ms": 1400,
    "stagger_ms": 110,
    "transitions": [
      "push",
      "wipe",
      "morph"
    ],
    "effects": [
      "wipe",
      "grow",
      "fly"
    ]
  },
  "signature_ideas": [
    "the cobalt square in the corner grows into the next chapter's full-bleed field (Morph) or wipes across (Wipe)",
    "bars that grow from a hairline baseline one after another, the number landing last",
    "a giant numeral cropped by the slide edge, pushed in from the right"
  ],
  "fit": {
    "domains": {
      "technology": 1,
      "engineering": 0.8,
      "science": 0.8,
      "aerospace": 0.7,
      "business": 0.6,
      "economy": 0.8,
      "finance": 0.7,
      "energy": 0.6,
      "climate": 0.6
    },
    "tones": [
      "precise",
      "calm",
      "technical",
      "analytical",
      "clear",
      "minimal"
    ],
    "material": {
      "bright": 0.7,
      "cool": 0.8
    },
    "avoid": [
      {
        "domain": "heritage",
        "because": "one cobalt on white in a strict modular grid is the look of a technical report"
      }
    ]
  }
}