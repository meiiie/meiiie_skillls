{
  "name": "glass-tech",
  "label": "Glass tech: midnight mesh gradient, frosted translucent cards, rounded geometric sans, cyan-violet glow",
  "genres": [
    "AI",
    "SaaS",
    "fintech",
    "product",
    "future",
    "keynote",
    "startup pitch"
  ],
  "palette": {
    "ground": "#0A0F24",
    "ground2": "#141B3D",
    "surface": "#FFFFFF",
    "ink": "#E9ECFF",
    "head": "#FFFFFF",
    "muted": "#BCC3EA",
    "faint": "#3A4378",
    "accent": "#7CF7FF",
    "accent2": "#B18CFF",
    "lit": "#7CF7FF",
    "veil": "#05081A"
  },
  "fonts": {
    "display": "Lexend",
    "text": "Inter",
    "label": "JetBrains Mono"
  },
  "font_files": [
    {
      "family": "Lexend",
      "weights": "400,700"
    },
    {
      "family": "Inter",
      "weights": "400,700"
    },
    {
      "family": "JetBrains Mono",
      "weights": "400,700"
    }
  ],
  "type": {
    "kicker": {
      "font": "label",
      "size": 12,
      "bold": true,
      "spacing": 1.5,
      "caps": true,
      "color": "accent"
    },
    "display": {
      "font": "display",
      "size": 88,
      "bold": true,
      "line": 0.9,
      "spacing": -2,
      "color": "head"
    },
    "title": {
      "font": "display",
      "size": 44,
      "bold": true,
      "line": 0.95,
      "spacing": -1,
      "color": "head"
    },
    "subtitle": {
      "font": "text",
      "size": 22,
      "line": 1.25,
      "color": "muted"
    },
    "body": {
      "font": "text",
      "size": 17,
      "line": 1.35,
      "color": "ink"
    },
    "caption": {
      "font": "text",
      "size": 10,
      "color": "muted"
    },
    "label": {
      "font": "label",
      "size": 11,
      "bold": true,
      "spacing": 1,
      "caps": true,
      "color": "muted"
    },
    "numeral": {
      "font": "display",
      "size": 170,
      "bold": true,
      "line": 0.82,
      "spacing": -4,
      "color": "accent"
    },
    "quote": {
      "font": "display",
      "size": 36,
      "bold": true,
      "line": 1.08,
      "color": "head"
    },
    "cardtitle": {
      "font": "display",
      "size": 22,
      "bold": true,
      "line": 1.05,
      "color": "head"
    },
    "pageno": {
      "font": "label",
      "size": 10,
      "bold": true,
      "color": "muted"
    }
  },
  "grid": {
    "cols": 12,
    "left": 0.9,
    "right": 0.9,
    "top": 0.8,
    "bottom": 0.8,
    "gutter": 0.25,
    "safe": 0.45
  },
  "default_bg": "main",
  "grounds": {
    "main": {
      "kind": "mesh",
      "base": "#0A0F24",
      "tone": "#3B2B8F",
      "blobs": [
        "#0E5E7A",
        "#1B2360"
      ],
      "grain": 0.02,
      "vignette": 0.5,
      "seed": 101
    },
    "alt": {
      "kind": "mesh",
      "base": "#0A0F24",
      "tone": "#0E5E7A",
      "blobs": [
        "#5A2A8F"
      ],
      "grain": 0.02,
      "vignette": 0.5,
      "seed": 102
    }
  },
  "chrome": {
    "over": [
      {
        "type": "ellipse",
        "name": "!!dot",
        "x": 0.9,
        "y": 0.53,
        "w": 0.14,
        "h": 0.14,
        "fill": "accent"
      },
      {
        "type": "text",
        "name": "!!running",
        "text": "{scene}",
        "x": 1.15,
        "y": 0.47,
        "w": 6,
        "h": 0.28,
        "role": "label"
      },
      {
        "type": "text",
        "name": "!!pageno",
        "text": "{n} / {total}",
        "x": 10.933,
        "y": 6.88,
        "w": 1.5,
        "h": 0.25,
        "role": "pageno",
        "align": "r"
      }
    ]
  },
  "card": {
    "fill": "#1A2250",
    "fill_alpha": 0.55,
    "line": "#FFFFFF",
    "line_width": 0.75,
    "radius": 0.12,
    "lit_fill": "#20305E",
    "lit_line": "accent",
    "rule": "accent",
    "dim_alpha": 0.55,
    "shadow": {
      "blur": 30,
      "dist": 10,
      "dir": 90,
      "color": "#000000",
      "alpha": 0.45
    }
  },
  "screen": {
    "bezel": "#141B3D",
    "line": "#3A4378",
    "line_width": 0.75,
    "radius": 0.1,
    "bar": "#1B2350"
  },
  "shadow": {
    "blur": 30,
    "dist": 10,
    "dir": 90,
    "color": "#000000",
    "alpha": 0.45
  },
  "photo": {
    "duotone": [
      "#0A0F24",
      "#7CF7FF"
    ],
    "veil": 0.55
  },
  "motion": {
    "default_ms": 1200,
    "bloom_ms": 1800,
    "stagger_ms": 150,
    "transitions": [
      "morph",
      "fade",
      "zoom",
      "vortex"
    ],
    "effects": [
      "rise",
      "float",
      "zoom",
      "pulse"
    ]
  },
  "signature_ideas": [
    "a looping background video (procedural aurora MP4) behind frosted cards",
    "cards float up with stagger and the key one breathes (pulse loop)",
    "a glowing orb orbits the product screen (orbit path, repeat)"
  ],
  "fit": {
    "domains": {
      "technology": 1,
      "software": 0.8,
      "business": 0.5,
      "aerospace": 0.4,
      "economy": 0.2
    },
    "tones": [
      "bold",
      "cinematic"
    ],
    "material": {
      "dark": 0.7,
      "cool": 0.9
    },
    "avoid": [
      {
        "domain": "heritage",
        "because": "frosted cyan-violet glass panels are the SaaS look"
      }
    ]
  }
}