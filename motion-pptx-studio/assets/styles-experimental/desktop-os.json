      "font": "display",
      "size": 40,
      "bold": true,
      "line": 0.95,
      "spacing": -1,
      "color": "head"
    },
    "subtitle": {
      "font": "text",
      "size": 22,
      "line": 1.25,
      "color": "head"
    },
    "body": {
      "font": "text",
      "size": 17,
      "line": 1.35,
      "color": "ink"
    },
    "caption": {
      "font": "text",
      "size": 10,
      "color": "muted"
    },
    "label": {
      "font": "label",
      "size": 11,
      "bold": true,
      "spacing": 1,
      "caps": true,
      "color": "muted"
