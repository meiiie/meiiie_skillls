    "numeral": {
      "font": "display",
      "size": 170,
      "bold": true,
      "line": 0.82,
      "spacing": -4,
      "color": "accent"
    },
    "quote": {
      "font": "display",
      "size": 36,
      "bold": true,
      "line": 1.08,
      "color": "head"
    },
