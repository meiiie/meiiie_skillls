{
  "name": "desktop-os",
  "label": "Desktop OS pastiche: wallpaper gradient, app windows with title bars and traffic dots, dock; a fictional UI, never a real brand",
  "genres": [
    "class presentation",
    "member intro",
    "app idea",
    "youth",
    "tutorial",
    "fun"
  ],
  "palette": {
    "ground": "#5B7CFA",
    "ground2": "#EEF1F8",
    "surface": "#FFFFFF",
    "ink": "#1D2433",
    "head": "#111827",
    "muted": "#26304A",
    "faint": "#DCE2EE",
    "accent": "#FF6B5B",
