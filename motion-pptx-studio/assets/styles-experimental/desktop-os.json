      "seed": 131
    },
    "alt": {
      "kind": "clean",
      "base": "#EEF1F8",
      "tone": "#E2E7F2",
      "grain": 0.0,
      "seed": 132
    }
  },
  "chrome": {
    "over": [
      {
        "type": "rect",
        "name": "!!menubar",
        "x": 0,
        "y": 0,
        "w": 13.333,
        "h": 0.56,
        "fill": "#FFFFFF",
        "alpha": 0.55
      },
      {
        "type": "text",
        "name": "!!menu",
        "text": "●  {scene}",
        "x": 0.5,
        "y": 0.3,
        "w": 6,
        "h": 0.25,
        "role": "pageno",
        "color": "head"
      },
      {
        "type": "text",
        "name": "!!clock",
        "text": "{n}/{total}",
        "x": 11.433,
        "y": 0.3,
        "w": 1.4,
        "h": 0.25,
        "role": "pageno",
        "align": "r",
        "color": "head"
      }
    ]
  },
  "card": {
    "fill": "surface",
    "fill_alpha": 0.92,
    "line": "faint",
    "line_width": 0.75,
    "radius": 0.06,
    "lit_fill": "#FFFFFF",
    "lit_line": "accent",
    "rule": "accent",
    "dim_alpha": 0.8,
    "shadow": {
      "blur": 28,
      "dist": 10,
      "dir": 90,
      "color": "#1D2433",
      "alpha": 0.3
    }
  },
  "screen": {
    "bezel": "#FFFFFF",
    "line": "#DCE2EE",
    "line_width": 0.75,
    "radius": 0.06,
    "bar": "#EEF1F8"
  },
  "shadow": {
    "blur": 28,
    "dist": 10,
    "dir": 90,
    "color": "#1D2433",
    "alpha": 0.3
  },
  "photo": {
    "duotone": null,
    "veil": 0.4
  },
  "motion": {
    "default_ms": 900,
    "bloom_ms": 1300,
    "stagger_ms": 120,
    "transitions": [
      "zoom",
      "morph",
      "gallery",
      "fade"
    ],
    "effects": [
      "zoom",
      "rise",
      "pulse"
    ]
  },
  "signature_ideas": [
    "a window opens with Grow/Zoom from its dock icon (Morph from the icon)",
    "an interactive menu: dock icons link to chapter slides (link) like slidewppt.vn decks",
    "notification toasts fly in from the top right"
  ],
  "fit": {
    "domains": {
      "youth": 1,
      "education": 0.7,
      "software": 0.5
    },
    "tones": [
      "playful"
    ],
    "material": {
      "bright": 0.5,
      "saturated": 0.5
    },
    "avoid": [
      {
        "domain": "heritage",
        "because": "a fictional UI pastiche frames its subject as an app"
      },
      {
        "domain": "aerospace",
        "because": "window chrome and a dock make real hardware look like a mock-up"
      },
      {
        "domain": "economy",
        "because": "a fictional desktop makes official statistics look like a game"
      }
    ]
  }
}